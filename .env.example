# ============================================================
# Backend environment variables (server/server.cjs)
# Copy this file to .env and fill in values before running.
# ============================================================

# Admin bearer token for destructive operations (bulk clear board).
# REQUIRED in production — admin endpoints return 503 if this is unset.
# Choose a long, random string. Example: openssl rand -hex 32
ADMIN_TOKEN=

# Comma-separated list of allowed CORS origins.
# In development, defaults to http://localhost:3000.
# In production, set this to your Vercel frontend URL (and any others).
# Example: ALLOWED_ORIGINS=https://your-app.vercel.app,https://staging.your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:3000

# Port the backend HTTP server listens on. Defaults to 8787.
PORT=8787

# ============================================================
# Frontend environment variables (Vite, prefix with VITE_)
# Create a .env.local file in the project root for local dev.
# Set these in your Vercel project settings for production.
# ============================================================

# Backend API base URL. No trailing slash.
# Development: http://localhost:8787
# Production:  https://your-railway-backend-url.railway.app
VITE_API_BASE=http://localhost:8787

# Optional: clientId of the browser session that should see the
# "Set Admin Token" button. Only needed by the project owner.
# Leave blank to hide the button for everyone.
VITE_ADMIN_CLIENT_ID=
